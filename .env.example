# ===== Server =====
PORT=3000
NODE_ENV=production
ADMIN_API_KEY=ganti-dengan-secret-acak-panjang

# ===== Database (PostgreSQL) =====
# Untuk Docker: DATABASE_URL akan di-override oleh docker-compose.yml
# Untuk local dev: ganti password & host sesuai PostgreSQL lokal Anda
DB_PASSWORD=ganti-password-db-anda
DATABASE_URL="postgresql://yorfinance:ganti-password-db-anda@localhost:5432/mankeu?schema=public"

# ===== Telegram Bot =====
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Username bot (tanpa @) — gunakan YorFinanceDevBot untuk development
TELEGRAM_BOT_USERNAME=YorFinanceBot

# ===== LLM Provider (Google Gemini) =====
OPENAI_API_KEY=your-gemini-api-key
OPENAI_MODEL=gemini-2.5-flash
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ===== SMTP Email (Gmail) =====
# Setup: myaccount.google.com → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="YorFinance <your-email@gmail.com>"

# ===== DOKU Payment Gateway =====
# Dashboard: https://dashboard.doku.com
DOKU_CLIENT_ID=BRN-0000-0000000000000000
DOKU_SECRET_KEY=your-doku-secret-key
DOKU_API_URL=https://api-sandbox.doku.com
DOKU_CALLBACK_URL=http://localhost:3000/api/payments/callback

# ===== Timezone =====
TZ=Asia/Jakarta

# ===== Dashboard =====
# URL dashboard yang dikirim via Telegram /dashboard command
# Untuk production: https://domain.com
DASHBOARD_BASE_URL=http://localhost:3000

# ===== Encryption =====
# Key untuk enkripsi data sensitif di DB (AES-256)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
