# ===== Server =====
PORT=3000
NODE_ENV=production
ADMIN_API_KEY=ganti-dengan-secret-acak-panjang

# ===== Database (PostgreSQL) =====
# Untuk Docker: DATABASE_URL akan di-override oleh docker-compose.yml
# Untuk local dev: ganti password & host sesuai PostgreSQL lokal Anda
DB_PASSWORD=ganti-password-db-anda
DATABASE_URL="postgresql://yorfinance:ganti-password-db-anda@localhost:5432/mankeu?schema=public"

# ===== Telegram Bot =====
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# ===== LLM Provider (Google Gemini) =====
OPENAI_API_KEY=your-gemini-api-key
OPENAI_MODEL=gemini-2.5-flash
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ===== SMTP Email (Gmail) =====
# Setup: myaccount.google.com → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="YorFinance <your-email@gmail.com>"

# ===== Google Sheets (Master Spreadsheet) =====
# Buat spreadsheet baru di Google Sheets, beri nama "YorFinance Master"
# Tambah 1 baris header (kolom A-G), lalu share ke service account
GOOGLE_SPREADSHEET_ID=your-master-spreadsheet-id

# ===== DOKU Payment Gateway =====
# Dashboard: https://dashboard.doku.com
DOKU_CLIENT_ID=BRN-0000-0000000000000000
DOKU_SECRET_KEY=your-doku-secret-key
DOKU_API_URL=https://api-sandbox.doku.com
DOKU_CALLBACK_URL=http://localhost:3000/api/payments/callback

# ===== Timezone =====
TZ=Asia/Jakarta
